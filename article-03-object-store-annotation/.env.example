# Copy this file to .env and fill in your own values.
# Never commit .env to version control.

# Label Studio database password
LS_DB_PASSWORD=replace-this-with-a-strong-database-password

# Label Studio secret key — use a long random string (50+ chars)
LS_SECRET_KEY=replace-this-with-a-long-random-secret-key

# MinIO credentials for Label Studio storage integration
# Create these with: mc admin user add local labelstudio-user <secret>
MINIO_ACCESS_KEY=labelstudio-user
MINIO_SECRET_KEY=replace-this-with-labelstudio-minio-secret
